.metadata/
#.settings/
.loadpath
.recommenders
#.project
#.classpath
*.launch
local.properties

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Claude Code local settings
.claude/settings.local.json

# OSGi / P2
*.index
configuration/org.eclipse.osgi/

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

